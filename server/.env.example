PORT=3000
NODE_ENV=development

# Web app origin (CORS) — set to Vercel URL in production
WEB_ORIGIN=*

# Supabase — server uses the SECRET service_role key (bypasses RLS; server-only, never expose to browser)
# Get it from: Supabase Dashboard > popup-platform project > Settings > API > service_role secret
SUPABASE_URL=https://cvrtobxkvpcpcxrcspdp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis (local dev; use Upstash URL in production)
REDIS_URL=redis://localhost:6379

# Channel settings
MAX_CHANNEL_CAPACITY=40

# Upstash free tier: player move Redis persist interval (ms). Default 500 in code.
REDIS_MOVE_PERSIST_MS=500
